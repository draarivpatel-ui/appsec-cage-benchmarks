    "envcage": "1.0.0",
    "headersafe": "1.0.1",
    "jsoncage": "1.0.0",
    "logcage": "1.0.0",
    "pathcage": "1.0.1",
    "redirectcage": "1.0.0",
    "sentinel-lint": "0.2.0",
    "zipcage": "1.0.0"
