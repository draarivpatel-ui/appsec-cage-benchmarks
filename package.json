{
  "name": "appsec-cage-benchmarks",
  "version": "1.0.0",
  "description": "Reproducible OWASP and CVE security benchmark suite for eighteen zero-dependency Node.js protection packages",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bench": "node src/run-benchmarks.mjs",
    "test": "node --test test/corpora.test.mjs test/detection.test.mjs test/hygiene.test.mjs test/report.test.mjs"
  },
  "keywords": [
    "security",
    "appsec",
    "owasp",
    "benchmarks",
    "nodejs",
    "devsecops",
    "cybersecurity",
    "testing"
  ],
  "dependencies": {
    "@aarivbuildz/csrfshield": "1.0.1",
    "@aarivbuildz/csvshield": "1.0.0",
    "@aarivbuildz/hookverify": "1.0.1",
    "@aarivbuildz/htmlclean": "0.1.0",
    "@aarivbuildz/jwtguard": "1.0.1",
    "@aarivbuildz/regex-shield": "1.0.0",
    "@aarivbuildz/secretsweep": "1.0.0",
    "@aarivbuildz/urlguard": "0.1.0",
    "cookiecage": "1.0.0",
    "corscage": "1.0.0",
    "envcage": "1.0.0",
    "headersafe": "1.0.1",
    "jsoncage": "1.0.0",
    "logcage": "1.0.0",
    "pathcage": "1.0.1",
    "redirectcage": "1.0.0",
    "sentinel-lint": "0.2.0",
    "zipcage": "1.0.0"
  }
}
